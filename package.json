    "@deepseek-ai/dsh-session-query": "link:../deepseek-harness/packages/session-query/session-query",
    "@deepseek-ai/dsh-session-title": "link:../deepseek-harness/packages/session/session-title",
    "@deepseek-ai/dsh-settings": "link:../deepseek-harness/packages/settings/settings",
    "@deepseek-ai/dsh-storage": "link:../deepseek-harness/packages/storage/storage",
    "@deepseek-ai/dsh-storage-domain": "link:../deepseek-harness/packages/storage/storage-domain",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "link:../deepseek-harness/node_modules/tsdown",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8",
    "zod": "4.4.3"
