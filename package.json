{
  "name": "dsh-session-workspaces",
  "version": "0.1.0",
  "description": "dsh plugin: workspace-and-group grouping for the Web sidebar Session list. The host half observes the FIRST human prompt of a Session through the session event stream, runs ONE hidden `ctx.llm.stream` classification call whose answer is validated against a closed candidate label set built from the directories under the Aweave `workspaces/` root plus a configured list, and stores the label, the plugin-owned group records and the Human pin durably in one `ctx.storageDomain` unit. The browser half reads that state through two admission-fenced `/api` routes, registers a `workspaceGrouping` provider so the sidebar's top level becomes the Aweave workspace (`k`, `tinybots`, `whill`, `unknown workspace`) and its second level a plugin-owned group, and adds assign / create-group / remove-member entries to the existing sidebar Session menu. Includes an opt-in Human-triggered backfill for Sessions that predate activation and a settings section choosing the classification model.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "private": true,
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "workspace",
    "grouping",
    "sidebar",
    "llm",
    "classification",
    "settings"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && tsdown --config tsdown.config.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck": "pnpm run check",
    "test": "pnpm run build && vitest run",
    "test:unit": "vitest run test/unit",
    "test:composition": "vitest run test/composition"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-session-projection": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-session-query": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-session-title": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.5-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.2",
    "zod": ">=4.4.3"
  },
  "peerDependenciesMeta": {
